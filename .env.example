# Copy to .env and fill in.  (chmod 600 .env)

# Web login password (use a long passphrase)
FOREST_PASSWORD=change-me
# Session signing key: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FOREST_SECRET=
# Public URL (OAuth for Claude.ai, links in pushes/calendar)
FOREST_PUBLIC_URL=https://tools.example.com
FOREST_TZ=UTC

# Host directories (created if missing). Vaults are plain folders you can back up,
# grep, or point other tools at; each vault is VAULTS_DIR/<name> and a git repo.
VAULTS_DIR=/srv/forest/vaults
STATE_DIR=/srv/forest/state
# Your host user/group (id -u, id -g) so files stay owned by you
PUID=1000
PGID=1000

# Docker port binding: the homeserver's VPN IP and port nginx will proxy to
BIND_IP=10.8.0.2
PORT=7700
# Trust X-Forwarded-For only from your nginx box (its VPN IP), so audit logs show real client IPs
FORWARDED_ALLOW_IPS=10.8.0.1

# Vaults (default forest,tasks) and upload limit (keep nginx client_max_body_size >= this)
FOREST_VAULTS=forest,tasks
FOREST_MAX_UPLOAD_MB=25

# Optional: ntfy push reminders (own server or ntfy.sh with a long random topic)
FOREST_NTFY_URL=
FOREST_NTFY_TOPIC=
FOREST_NTFY_TOKEN=
FOREST_DIGEST_TIME=08:00
FOREST_WEEKLY_TIME=sun 19:00
