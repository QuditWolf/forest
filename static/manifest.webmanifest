{
  "id": "/",
  "name": "forest",
  "short_name": "forest",
  "description": "Personal knowledge base and task planner",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#f8f8f8",
  "categories": ["productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/clip",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "today", "short_name": "today", "url": "/#today", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "capture", "short_name": "capture", "url": "/clip", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
